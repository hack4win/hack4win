# Postgres — database connection
DATABASE_URL="postgresql://user:password@endpoint.aws.neon.tech/do4win?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@endpoint-pooler.aws.neon.tech/do4win?sslmode=require&channel_binding=require"

# Neon Auth — sign-in for your app
NEON_AUTH_BASE_URL="https://endpoint.neonauth.aws.neon.tech/do4win/auth"

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3="https://endpoint.storage.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="ap-southeast-1"
S3_BUCKET="do4win"
